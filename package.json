{
  "name": "platform-sdk-reactnative-expo",
  "private": true,
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/youversion/platform-sdk-reactnative-expo.git"
  },
  "scripts": {
    "build": "CI=true turbo build",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "clean:cache": "bash scripts/clear-cache.sh",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:native-i18n": "node scripts/test-native-i18n-oxlint.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:locale-parity": "node scripts/check-locale-parity.mjs",
    "check:locale-json-guard": "node scripts/check-locale-parity.mjs --guard",
    "generate:locale-index": "node scripts/generate-locale-index.mjs",
    "check:locale-index": "node scripts/generate-locale-index.mjs --check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build && pnpm exec changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "@oxlint/plugins": "1.78.0",
    "eslint-plugin-expo": "1.1.0",
    "eslint-plugin-i18next": "6.1.4",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
