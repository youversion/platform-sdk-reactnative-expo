{
  "name": "example",
  "version": "1.0.9",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "start:clear-cache": "npx expo start -c",
    "clean:cache": "pnpm -w clean:cache",
    "fix:deps": "expo install --fix",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "build:ios": "expo run:ios",
    "build:ios-device": "expo run:ios --device",
    "build:ios-release": "expo run:ios --variant release",
    "build:android-release": "expo run:android --variant release",
    "build:android": "expo run:android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/dom-webview": "57.0.1",
    "@expo/metro-runtime": "57.0.15",
    "@gorhom/bottom-sheet": "5.2.14",
    "@rn-primitives/portal": "1.4.0",
    "@youversion/platform-react-native-expo-core": "workspace:*",
    "@youversion/platform-react-native-expo-ui": "workspace:*",
    "expo": "57.0.23",
    "expo-application": "57.0.3",
    "expo-build-properties": "57.0.20",
    "expo-clipboard": "57.0.2",
    "expo-crypto": "57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-font": "57.0.4",
    "expo-linking": "57.0.10",
    "expo-network": "57.0.2",
    "expo-router": "57.0.20",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "57.0.1",
    "expo-web-browser": "57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-mmkv": "4.3.1",
    "react-native-nitro-modules": "0.35.6",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
