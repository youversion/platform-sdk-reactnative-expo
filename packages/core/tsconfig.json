{
  "extends": "expo-module-scripts/tsconfig.base",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "build",
    // src/sdk-version.ts imports ../package.json; the base config leaves this off.
    "resolveJsonModule": true
  },
  "include": ["src"],
  "exclude": [
    "src/**/__tests__/**",
    "src/**/__mocks__/**",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test-utils/**",
    "src/**/test-utils/**"
  ]
}
