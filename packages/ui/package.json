{
  "name": "@youversion/platform-react-native-expo-ui",
  "version": "1.6.0",
  "description": "YouVersion Platform Bible components for React Native (Expo) — reader, verse cards, Verse of the Day, theming, and native sheets.",
  "keywords": [
    "youversion",
    "bible",
    "scripture",
    "expo",
    "react-native",
    "expo-dom-components"
  ],
  "homepage": "https://github.com/youversion/platform-sdk-reactnative-expo#readme",
  "bugs": "https://github.com/youversion/platform-sdk-reactnative-expo/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/youversion/platform-sdk-reactnative-expo.git",
    "directory": "packages/ui"
  },
  "license": "Apache-2.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "main": "build/index.js",
    "types": "build/index.d.ts",
    "exports": {
      ".": {
        "types": "./build/index.d.ts",
        "default": "./build/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "expo-module prepublishOnly"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@expo-google-fonts/source-serif-4": "0.4.1",
    "@radix-ui/react-use-controllable-state": "1.2.2",
    "@rn-primitives/accordion": "1.4.0",
    "@rn-primitives/popover": "1.4.0",
    "@rn-primitives/portal": "1.4.0",
    "@rn-primitives/tabs": "1.4.0",
    "@youversion/platform-core": "2.13.0",
    "@youversion/platform-react-native-expo-core": "workspace:*",
    "@youversion/platform-react-ui": "2.15.0",
    "expo-localization": "57.0.2",
    "i18next": "26.3.1",
    "react-i18next": "17.0.8",
    "zod": "4.4.3",
    "zustand": "5.0.13"
  },
  "peerDependencies": {
    "@expo/dom-webview": ">=57.0.0 <58.0.0",
    "@gorhom/bottom-sheet": ">=5.0.0",
    "expo": ">=57.0.0 <58.0.0",
    "expo-application": ">=57.0.0 <58.0.0",
    "expo-clipboard": ">=57.0.0 <58.0.0",
    "expo-font": ">=57.0.0 <58.0.0",
    "expo-web-browser": ">=57.0.0 <58.0.0",
    "react": ">=19.0.0 <20.0.0",
    "react-dom": ">=19.0.0 <20.0.0",
    "react-native": ">=0.86.0",
    "react-native-gesture-handler": ">=2.16.1",
    "react-native-reanimated": ">=4.4.0",
    "react-native-safe-area-context": ">=5.0.0",
    "react-native-svg": ">=15.15.0",
    "react-native-webview": ">=13.13.0",
    "react-native-worklets": ">=0.9.1"
  },
  "peerDependenciesMeta": {
    "react-native-webview": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "babel-preset-expo": "57.0.11",
    "expo-module-scripts": "56.0.3",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "react-test-renderer": "19.2.5"
  }
}
